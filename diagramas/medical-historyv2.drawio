],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];fillColor=#E7157B;strokeColor=#ffffff;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="600" y="670" width="78" height="78" as="geometry"/></mxCell><mxCell id="leyenda" value="Líneas punteadas rojas = seguridad (WAF, KMS, GuardDuty) · grises = auditoría (CloudTrail).&lt;br&gt;Cada Lambda tiene su propio rol de IAM con mínimo privilegio. El certificado de ACM y el WAF de CloudFront se crean en us-east-1.&lt;br&gt;Logs de auditoría WORM: nadie (ni root) puede borrarlos durante 365 días; idealmente en una cuenta aparte solo para logs." style="text;align=left;verticalAlign=top;html=1;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1500" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>