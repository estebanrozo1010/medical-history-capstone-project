lue="S3 mh-trail&#xa;(versionado + política&#xa;que niega borrar)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;gradientColor=none;fillColor=#7AA116;strokeColor=none;pointerEvents=1;shape=mxgraph.aws4.bucket;" vertex="1" parent="1"><mxGeometry x="380" y="670" width="78" height="78" as="geometry"/></mxCell><mxCell id="leyenda" value="Líneas punteadas rojas = seguridad (KMS) · grises = auditoría (CloudTrail, CloudWatch).&lt;br&gt;LabRole para las 4 Lambdas y la réplica: el laboratorio no permite crear roles de IAM.&lt;br&gt;Bloqueado en el Learner Lab: CloudFront, AWS WAF, GuardDuty Malware Protection, S3 Object Lock y registro de dominios (Route 53)." style="text;align=left;verticalAlign=top;html=1;fontSize=12;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1500" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>